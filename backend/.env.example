PORT=3001
JWT_SECRET=a-long-random-secret
MONGO_URI=mongodb+srv://user:password@cluster.example.mongodb.net/database

# The addresses of the frontend that may call the backend, separated by commas, without a path.
# Required when NODE_ENV is production; development uses http://localhost:5173 when it is not set.
CORS_ORIGINS=https://app.example.com

# The number of proxies in front of the backend, usually 1 on a hosting platform. Leave it out without a proxy.
# Without it behind a proxy, all users share one login and signup limit.
TRUST_PROXY=1
